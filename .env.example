# Copy to .env for docker compose. Every value is optional; .env itself is never committed (TP-SRS-182).

# When set, the Host's POST /run requires this key in the X-API-Key header, and the web
# application sends it. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HOST_API_KEY=

# Metrics over OTLP/HTTP, for example to Grafana Cloud. Leave empty to send no metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
